  function nativeLiveKick(){
    if(!nativeLive.on || nativeLive.running) return;
    nativeLive.running = true;
    liveSetState('listening');
    hint2('正在听…（连续对话）');
    try{ window.NativeASR.start(); }
    catch(e){
      nativeLive.running = false;
      sys('连续对话启动失败：' + e.message);
